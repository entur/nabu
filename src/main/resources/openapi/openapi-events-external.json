{
  "openapi": "3.0.1",
  "info": {
    "title": "Timetable Delivery Status",
    "description": "Status of a timetable data delivery",
    "version": "1.0.0",
    "contact": {
      "name": "Entur",
      "url": "https://developer.entur.org"
    },
    "x-entur-metadata": {
      "id": "timetable-delivery-status",
      "audience": "partner",
      "owner": "team-ror"
    }
  },
  "servers": [
    {
      "url": "https://api.dev.entur.io/timetable/v1/timetable-events",
      "description": "Development"
    },
    {
      "url": "https://api.staging.entur.io/timetable/v1/timetable-events",
      "description": "Staging"
    },
    {
      "url": "https://api.entur.io/timetable/v1/timetable-events",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "timetable-delivery-status",
      "description": "Status of a timetable data delivery"
    }
  ],
  "paths": {
    "/status/{codespace}/{correlationId}": {
      "get": {
        "tags": [
          "timetable-delivery-status"
        ],
        "summary": "Get the status of a timetable data delivery",
        "description": "Return the status of the delivery identified by its correlation id",
        "operationId": "getDataDeliveryStatus",
        "parameters": [
          {
            "name": "codespace",
            "in": "path",
            "required": true,
            "description": "Codespace identifying the data provider (e.g. 'RUT').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "description": "Correlation id assigned to the delivery when it was submitted.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery status for the requested correlation id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataDeliveryStatus"
                },
                "example": {
                  "state": "OK",
                  "date": "2026-04-17T10:30:00Z",
                  "fileName": "rut-netex_202604171030.zip"
                }
              }
            }
          }
        }
      }
    },
    "/progress/{correlationId}": {
      "get": {
        "tags": [
          "timetable-delivery-status"
        ],
        "summary": "Get the per-stage progress of a timetable data delivery",
        "description": "Return one element per pipeline stage observed for the delivery identified by its correlation id, each with its current status and, when it failed, the error code.\n\nThe response describes what happened, not what was planned. There is no fixed list of stages an import will run — which stages apply depends on the data provider and on the dataset — so only stages that actually reported something are returned. A stage absent from the response is one the import has not reached, or was not run for this provider, or that stopped the pipeline before it could start.\n\nThe GRAPH_BUILD stage reports a single Entur-wide graph build that is shared by all data providers.",
        "operationId": "getImportProgress",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "description": "Correlation id assigned to the delivery when it was submitted.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stages observed for the requested correlation id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportProgress"
                },
                "examples": {
                  "inProgress": {
                    "summary": "An import still running",
                    "description": "Everything up to the export has finished and the shared graph build is queued. Stages the import has not reached are simply absent.",
                    "value": {
                      "codespace": "RUT",
                      "correlationId": "9f3c1b2e-7a44-4f10-9c1d-2b8e5a6f0d13",
                      "stages": [
                        {
                          "stage": "FILE_TRANSFER",
                          "status": "COMPLETED",
                          "startedAt": "2026-09-30T10:30:00Z",
                          "completedAt": "2026-09-30T10:30:04Z",
                          "errorCode": null
                        },
                        {
                          "stage": "FILE_CLASSIFICATION",
                          "status": "COMPLETED",
                          "startedAt": "2026-09-30T10:30:04Z",
                          "completedAt": "2026-09-30T10:30:05Z",
                          "errorCode": null
                        },
                        {
                          "stage": "PREVALIDATION",
                          "status": "COMPLETED",
                          "startedAt": "2026-09-30T10:30:05Z",
                          "completedAt": "2026-09-30T10:34:12Z",
                          "errorCode": null
                        },
                        {
                          "stage": "NETEX_EXPORT",
                          "status": "COMPLETED",
                          "startedAt": "2026-09-30T10:34:13Z",
                          "completedAt": "2026-09-30T10:36:48Z",
                          "errorCode": null
                        },
                        {
                          "stage": "GRAPH_BUILD",
                          "status": "PENDING",
                          "startedAt": null,
                          "completedAt": null,
                          "errorCode": null
                        }
                      ]
                    }
                  },
                  "failedPrevalidation": {
                    "summary": "An import stopped by a failed validation",
                    "description": "Prevalidation rejected the dataset, so the pipeline stopped there and no later stage ever ran. Nothing follows the failed stage.",
                    "value": {
                      "codespace": "RUT",
                      "correlationId": "2d7a4e91-3c05-4b68-88ff-6e1a0c4b7d52",
                      "stages": [
                        {
                          "stage": "FILE_TRANSFER",
                          "status": "COMPLETED",
                          "startedAt": "2026-09-30T10:30:00Z",
                          "completedAt": "2026-09-30T10:30:04Z",
                          "errorCode": null
                        },
                        {
                          "stage": "FILE_CLASSIFICATION",
                          "status": "COMPLETED",
                          "startedAt": "2026-09-30T10:30:04Z",
                          "completedAt": "2026-09-30T10:30:05Z",
                          "errorCode": null
                        },
                        {
                          "stage": "PREVALIDATION",
                          "status": "FAILED",
                          "startedAt": "2026-09-30T10:30:05Z",
                          "completedAt": "2026-09-30T10:34:12Z",
                          "errorCode": null
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No or invalid access token."
          },
          "403": {
            "description": "The delivery exists, but the caller is not entitled to edit route data for the codespace that owns it."
          },
          "404": {
            "description": "No events are recorded for this correlation id."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DataDeliveryStatus": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "IN_PROGRESS",
              "FAILED",
              "OK"
            ]
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "fileName": {
            "type": "string"
          }
        }
      },
      "ImportProgress": {
        "type": "object",
        "description": "Per-stage progress of one timetable data delivery.",
        "properties": {
          "codespace": {
            "type": "string",
            "description": "Codespace of the data provider that owns the delivery. Resolved from the correlation id; it is not supplied by the caller.",
            "example": "RUT"
          },
          "correlationId": {
            "type": "string",
            "description": "The correlation id from the request path.",
            "example": "9f3c1b2e-7a44-4f10-9c1d-2b8e5a6f0d13"
          },
          "stages": {
            "type": "array",
            "description": "One element per pipeline stage observed for this delivery, ordered by the stage's earliest recorded event.",
            "items": {
              "$ref": "#/components/schemas/ImportProgressStage"
            }
          }
        }
      },
      "ImportProgressStage": {
        "type": "object",
        "description": "The latest known state of one pipeline stage.",
        "properties": {
          "stage": {
            "type": "string",
            "description": "The pipeline stage. IMPORT, VALIDATION_LEVEL_1, VALIDATION_LEVEL_2 and DATASPACE_TRANSFER are steps of the legacy import path and will disappear when it is retired.",
            "enum": [
              "FILE_TRANSFER",
              "FILE_CLASSIFICATION",
              "PREVALIDATION",
              "IMPORT",
              "VALIDATION_LEVEL_1",
              "VALIDATION_LEVEL_2",
              "DATASPACE_TRANSFER",
              "LINKING",
              "FILTERING",
              "NETEX_EXPORT",
              "POSTVALIDATION",
              "BLOCKS_EXPORT",
              "BLOCKS_POSTVALIDATION",
              "MERGED_POSTVALIDATION",
              "GTFS_EXPORT",
              "GRAPH_BUILD"
            ]
          },
          "status": {
            "type": "string",
            "description": "FAILED covers both a stage that reported an error and one that never came back. An errorCode is present only in the first case.",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "FAILED"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the stage started. Not every step reports a start of its own, and one that does not falls back to the time it finished. Null only while the stage is still PENDING."
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the stage reached its final state. Null while the stage is unfinished."
          },
          "errorCode": {
            "type": "string",
            "description": "Why the stage failed. Null unless status is FAILED, and null on a FAILED stage that never reported a reason — a failed validation is always one of those, because what was wrong with the data is answered by the validation report for the same correlation id rather than by a code here. Deliberately not an enumeration: new codes are added upstream and are additive.",
            "nullable": true,
            "example": "NO_JOURNEYS_IN_NETEX_DATASET"
          }
        }
      }
    }
  }
}